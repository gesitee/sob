---
---

<section id="kategori" class="py-12 sm:py-16 lg:py-24 bg-white">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mx-auto mb-10 sm:mb-14 max-w-2xl text-center">
      <span class="inline-flex rounded-full bg-orange-100 px-4 py-1.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-sob-orange">Katalog Kami</span>
      <h2 class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900">Pilih Kebutuhan Anda</h2>
      <p class="mt-4 text-sm sm:text-base leading-relaxed text-gray-500">Temukan berbagai kebutuhan dapur untuk belanja harian keluarga Anda.</p>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-5">
      <!-- Sayuran -->
      <div class="hover-card group rounded-2xl sm:rounded-3xl border border-gray-100 bg-white p-3 sm:p-5 lg:p-6 text-center shadow-sm relative flex flex-col">
        <a href="/kategori/sayur-segar" class="block outline-none" aria-label="Lihat Sayuran Segar">
          <div class="mx-auto mb-3 sm:mb-5 flex h-14 w-14 sm:h-16 sm:w-16 lg:h-20 lg:w-20 items-center justify-center rounded-xl sm:rounded-2xl bg-green-50 transition group-hover:-translate-y-1">
            <i class="fas fa-leaf text-2xl sm:text-3xl lg:text-4xl text-sob-green"></i>
          </div>
          <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 hover:text-sob-green transition">Sayuran</h3>
          <p class="mt-1 hidden sm:block text-xs text-gray-500">Segar tiap pagi</p>
        </a>
        <button type="button" data-category="Sayuran Segar" class="category-btn mt-auto pt-3 outline-none">
          <span class="block rounded-lg sm:rounded-xl bg-green-50 py-2 text-xs sm:text-sm font-bold text-sob-green transition hover:bg-sob-green hover:text-white active:scale-95">Pesan WA</span>
        </button>
      </div>

      <!-- Buah -->
      <div class="hover-card group rounded-2xl sm:rounded-3xl border border-gray-100 bg-white p-3 sm:p-5 lg:p-6 text-center shadow-sm relative flex flex-col">
        <a href="/kategori/buah" class="block outline-none" aria-label="Lihat Buah-buahan">
          <div class="mx-auto mb-3 sm:mb-5 flex h-14 w-14 sm:h-16 sm:w-16 lg:h-20 lg:w-20 items-center justify-center rounded-xl sm:rounded-2xl bg-yellow-50 transition group-hover:-translate-y-1">
            <i class="fas fa-apple-whole text-2xl sm:text-3xl lg:text-4xl text-yellow-500"></i>
          </div>
          <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 hover:text-yellow-600 transition">Buah</h3>
          <p class="mt-1 hidden sm:block text-xs text-gray-500">Manis & vitamin</p>
        </a>
        <button type="button" data-category="Buah-buahan" class="category-btn mt-auto pt-3 outline-none">
          <span class="block rounded-lg sm:rounded-xl bg-yellow-50 py-2 text-xs sm:text-sm font-bold text-yellow-600 transition hover:bg-yellow-500 hover:text-white active:scale-95">Pesan WA</span>
        </button>
      </div>

      <!-- Lauk -->
      <div class="hover-card group rounded-2xl sm:rounded-3xl border border-gray-100 bg-white p-3 sm:p-5 lg:p-6 text-center shadow-sm relative flex flex-col">
        <a href="/kategori/lauk-pauk" class="block outline-none" aria-label="Lihat Lauk Pauk">
          <div class="mx-auto mb-3 sm:mb-5 flex h-14 w-14 sm:h-16 sm:w-16 lg:h-20 lg:w-20 items-center justify-center rounded-xl sm:rounded-2xl bg-red-50 transition group-hover:-translate-y-1">
            <i class="fas fa-fish text-2xl sm:text-3xl lg:text-4xl text-red-500"></i>
          </div>
          <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 hover:text-red-600 transition">Lauk Pauk</h3>
          <p class="mt-1 hidden sm:block text-xs text-gray-500">Ikan & daging</p>
        </a>
        <button type="button" data-category="Lauk, Ikan & Daging" class="category-btn mt-auto pt-3 outline-none">
          <span class="block rounded-lg sm:rounded-xl bg-red-50 py-2 text-xs sm:text-sm font-bold text-red-600 transition hover:bg-red-500 hover:text-white active:scale-95">Pesan WA</span>
        </button>
      </div>

      <!-- Sembako -->
      <div class="hover-card group rounded-2xl sm:rounded-3xl border border-gray-100 bg-white p-3 sm:p-5 lg:p-6 text-center shadow-sm relative flex flex-col">
        <a href="/kategori/sembako" class="block outline-none" aria-label="Lihat Sembako & Bumbu">
          <div class="mx-auto mb-3 sm:mb-5 flex h-14 w-14 sm:h-16 sm:w-16 lg:h-20 lg:w-20 items-center justify-center rounded-xl sm:rounded-2xl bg-orange-50 transition group-hover:-translate-y-1">
            <i class="fas fa-jar-wheat text-2xl sm:text-3xl lg:text-4xl text-sob-orange"></i>
          </div>
          <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 hover:text-sob-orange transition">Sembako</h3>
          <p class="mt-1 hidden sm:block text-xs text-gray-500">Beras, minyak, dll</p>
        </a>
        <button type="button" data-category="Sembako & Bumbu" class="category-btn mt-auto pt-3 outline-none">
          <span class="block rounded-lg sm:rounded-xl bg-orange-50 py-2 text-xs sm:text-sm font-bold text-sob-orange transition hover:bg-sob-orange hover:text-white active:scale-95">Pesan WA</span>
        </button>
      </div>

      <!-- Siap Masak -->
      <div class="hover-card group col-span-2 md:col-span-1 rounded-2xl sm:rounded-3xl border border-gray-100 bg-white p-3 sm:p-5 lg:p-6 text-center shadow-sm relative flex flex-col">
        <a href="/kategori/siap-masak" class="block outline-none" aria-label="Lihat Paket Siap Masak">
          <div class="mx-auto mb-3 sm:mb-5 flex h-14 w-14 sm:h-16 sm:w-16 lg:h-20 lg:w-20 items-center justify-center rounded-xl sm:rounded-2xl bg-purple-50 transition group-hover:-translate-y-1">
            <i class="fas fa-utensils text-2xl sm:text-3xl lg:text-4xl text-purple-500"></i>
          </div>
          <h3 class="text-sm sm:text-base lg:text-lg font-bold text-gray-900 hover:text-purple-600 transition">Siap Masak</h3>
          <p class="mt-1 hidden sm:block text-xs text-gray-500">Praktis & cepat</p>
        </a>
        <button type="button" data-category="Paket Sayur Siap Masak" class="category-btn mt-auto pt-3 outline-none">
          <span class="block rounded-lg sm:rounded-xl bg-purple-50 py-2 text-xs sm:text-sm font-bold text-purple-600 transition hover:bg-purple-500 hover:text-white active:scale-95">Pesan WA</span>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  import { generateWhatsAppUrl } from '../../lib/whatsapp';

  const buttons = document.querySelectorAll('.category-btn');
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');
      if (category) {
        const message = `Halo SOB, saya mau pesan ${category}`;
        window.open(generateWhatsAppUrl(message), '_blank');
      }
    });
  });
</script>
