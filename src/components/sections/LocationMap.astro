---
---

<section id="lokasi" class="py-12 sm:py-16 lg:py-24 bg-gray-900 relative overflow-hidden">
  <!-- Background Decor -->
  <div class="absolute top-0 left-0 w-full h-full opacity-[0.03] pointer-events-none" style="background-image: url('data:image/svg+xml,%3Csvg width=\'20\' height=\'20\' viewBox=\'0 0 20 20\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'1\' fill-rule=\'evenodd\'%3E%3Ccircle cx=\'3\' cy=\'3\' r=\'1\'/%3E%3Ccircle cx=\'13\' cy=\'13\' r=\'1\'/%3E%3C/g%3E%3C/svg%3E');" aria-hidden="true"></div>
  
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row gap-8 lg:gap-0 items-center">
      <!-- Kartu Putih Melayang -->
      <div class="w-full lg:w-5/12 bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-2xl z-20 lg:-mr-12 border border-gray-100">
        <h2 class="text-2xl sm:text-3xl font-extrabold mb-6 sm:mb-8 text-gray-900 border-b border-gray-100 pb-4">Info Toko & Layanan</h2>
        
        <div class="flex items-start gap-3 sm:gap-4 mb-6 group">
          <div class="bg-orange-100 w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center flex-shrink-0 transition duration-300">
            <i class="fas fa-map-marker-alt text-sob-orange text-lg sm:text-xl"></i>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base sm:text-lg mb-1">Alamat Outlet SOB</h4>
            <p class="text-gray-600 text-xs sm:text-sm leading-relaxed font-medium">589X+36G, Jogonalan Kidul, Tirtonirmolo, Kec. Kasihan, Kabupaten Bantul, DIY 55184</p>
          </div>
        </div>

        <div class="flex items-start gap-3 sm:gap-4 mb-8 group">
          <div class="bg-green-100 w-10 h-10 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center flex-shrink-0 transition duration-300">
            <i class="fas fa-clock text-sob-green text-lg sm:text-xl"></i>
          </div>
          <div>
            <h4 class="font-bold text-gray-900 text-base sm:text-lg mb-1">Jam Operasional</h4>
            <p class="text-gray-600 text-xs sm:text-sm font-medium">Setiap Hari (Senin - Minggu)<br><span class="text-sob-green font-bold text-sm sm:text-base">Buka: 04.30 - 22.00 WIB</span></p>
          </div>
        </div>

        <a href="https://maps.app.goo.gl/Rxh4yqmybFcY6FuE8" target="_blank" rel="noopener noreferrer" class="w-full bg-gray-900 hover:bg-gray-800 text-white px-6 py-3.5 rounded-xl flex justify-center items-center gap-2 font-bold transition shadow-md active:scale-[.98]">
          <i class="fas fa-location-arrow"></i> Buka di Google Maps
        </a>
      </div>

      <!-- Map iframe with fluid height using clamp -->
      <div class="w-full lg:w-7/12 h-[clamp(320px,60vw,500px)] overflow-hidden rounded-3xl border-4 border-gray-800 shadow-2xl relative z-10">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d15810.824969248232!2d110.3340578!3d-7.8209869!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x2e7a57a00b4179cb%3A0xd07922171c1c6931!2sSayur%20Online%20Bantul!5e0!3m2!1sen!2sid!4v1700000000000!5m2!1sen!2sid" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade" class="grayscale-[15%] hover:grayscale-0 transition duration-500" title="Lokasi Sayur Online Bantul di Google Maps"></iframe>
      </div>
    </div>

    <!-- GrabMart Callout (Valid URL Template) -->
    <div class="mt-12 lg:mt-16 bg-gradient-to-r from-[#00B14F] to-[#009140] rounded-[2rem] p-6 sm:p-8 lg:p-10 text-white shadow-2xl relative overflow-hidden group">
      <div class="absolute right-0 top-0 w-64 h-full bg-white opacity-5 skew-x-12 translate-x-10" aria-hidden="true"></div>
      <div class="absolute -right-10 -bottom-10 opacity-20 transition duration-500" aria-hidden="true">
        <i class="fas fa-shopping-bag text-[8rem] sm:text-[12rem]"></i>
      </div>
      
      <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6 sm:gap-8">
        <div class="text-center md:text-left flex-1">
          <div class="inline-flex items-center gap-2 bg-white text-[#00B14F] text-[10px] sm:text-xs font-extrabold px-3 sm:px-4 py-1.5 rounded-full uppercase tracking-widest mb-4 shadow-sm">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span> Instan Delivery
          </div>
          <h3 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold mb-2">Area Tirtonirmolo & Sekitarnya?</h3>
          <p class="text-green-50 text-sm sm:text-lg font-medium max-w-2xl">Butuh bahan masakan darurat atau lagi mager keluar? Kini SOB tersedia di <strong class="text-yellow-300">GrabMart</strong>. Pesan sekarang, sampai dalam hitungan menit!</p>
        </div>
        <!-- CTA -->
        <div class="w-full md:w-auto">
          <a href="https://food.grab.com/id/id/" target="_blank" rel="noopener noreferrer" class="inline-flex min-h-12 w-full md:w-auto items-center justify-center gap-3 rounded-xl bg-white px-6 sm:px-8 py-3.5 text-base sm:text-lg font-extrabold text-[#00B14F] shadow-lg transition hover:bg-gray-50 active:scale-[.98]">
            <i class="fas fa-motorcycle text-xl"></i> Pesan via GrabMart
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
