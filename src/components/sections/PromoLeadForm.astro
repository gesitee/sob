---
---

<section id="promo-form" class="py-12 sm:py-16 lg:py-24 bg-white relative border-t border-gray-50">
  <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-sob-green to-green-900 rounded-[2rem] overflow-hidden shadow-2xl relative">
      <div class="absolute top-0 right-0 -mr-20 -mt-20 w-64 h-64 rounded-full bg-white opacity-5 blur-3xl" aria-hidden="true"></div>
      
      <div class="flex flex-col lg:flex-row relative z-10">
        <!-- Text Copy -->
        <div class="p-8 sm:p-10 lg:p-12 lg:w-1/2 text-white flex flex-col justify-center">
          <span class="bg-sob-orange text-white px-4 py-1.5 rounded-full text-xs font-bold w-fit mb-5 uppercase tracking-wider shadow-sm">Khusus Pelanggan Baru</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold mb-4 leading-tight">Belum Mau Pesan Hari Ini?</h2>
          <p class="text-green-50 mb-8 leading-relaxed opacity-90 text-sm sm:text-base">
            Daftarkan WhatsApp Anda sekarang! Dapatkan <strong>Voucher Diskon 10%</strong> untuk pesanan perdana, plus info update harga sayur harian yang sedang promo.
          </p>
          <ul class="space-y-4 mb-2">
            <li class="flex items-center gap-3 font-medium text-sm sm:text-base"><div class="bg-green-700/50 p-2 rounded-full"><i class="fas fa-check text-sob-orange"></i></div> Diskon 10% tanpa syarat ribet</li>
            <li class="flex items-center gap-3 font-medium text-sm sm:text-base"><div class="bg-green-700/50 p-2 rounded-full"><i class="fas fa-bell text-sob-orange"></i></div> Akses promo mingguan SOB</li>
          </ul>
        </div>

        <!-- Optimized Form (A11y + Inputmodes) -->
        <div class="bg-white p-8 sm:p-10 lg:p-12 lg:w-1/2 m-2 sm:m-3 rounded-[1.5rem] shadow-soft">
          <form id="leadsForm" class="space-y-5">
            <div>
              <label for="leadName" class="mb-1.5 block text-sm font-bold text-gray-700">Nama Lengkap</label>
              <input type="text" id="leadName" name="name" autocomplete="name" required class="min-h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 sm:px-5 py-3.5 font-medium text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-sob-green focus:ring-4 focus:ring-green-100" placeholder="Misal: Ibu Nisa">
            </div>
            <div>
              <label for="leadPhone" class="mb-1.5 block text-sm font-bold text-gray-700">Nomor WhatsApp</label>
              <input type="tel" id="leadPhone" name="phone" inputmode="numeric" autocomplete="tel" required class="min-h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 sm:px-5 py-3.5 font-medium text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-sob-green focus:ring-4 focus:ring-green-100" placeholder="0895xxxxxx">
            </div>
            <div>
              <label for="leadArea" class="mb-1.5 block text-sm font-bold text-gray-700">Area Tempat Tinggal</label>
              <input type="text" id="leadArea" name="area" autocomplete="address-level2" required class="min-h-12 w-full rounded-xl border border-gray-200 bg-gray-50/50 px-4 sm:px-5 py-3.5 font-medium text-gray-900 outline-none transition placeholder:text-gray-400 focus:border-sob-green focus:ring-4 focus:ring-green-100" placeholder="Misal: Kasihan, Bantul">
            </div>
            <button type="submit" class="min-h-12 w-full bg-sob-orange hover:bg-orange-600 text-white font-bold py-3.5 rounded-xl transition shadow-lg shadow-orange-500/30 flex items-center justify-center gap-2 text-base sm:text-lg mt-2 active:scale-[.98]">
              <i class="fas fa-paper-plane"></i> Kirim & Klaim Promo
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { generateWhatsAppUrl } from '../../lib/whatsapp';

  const form = document.getElementById('leadsForm') as HTMLFormElement;
  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      
      const name = (document.getElementById('leadName') as HTMLInputElement).value;
      const phone = (document.getElementById('leadPhone') as HTMLInputElement).value;
      const area = (document.getElementById('leadArea') as HTMLInputElement).value;
      
      if (name && phone && area) {
        const message = `Halo SOB, saya ${name} dari ${area}. Saya ingin klaim promo diskon 10% pelanggan baru. Nomor WA: ${phone}`;
        window.open(generateWhatsAppUrl(message), '_blank');
      }
    });
  }
</script>
