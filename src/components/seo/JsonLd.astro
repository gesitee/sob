---
import { siteConfig } from '../../config/site';

interface Props {
  type?: 'GroceryStore' | 'LocalBusiness' | 'WebSite';
  title?: string;
  description?: string;
}

const { 
  type = 'GroceryStore',
  title = siteConfig.name,
  description = siteConfig.description
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": type,
  "name": title,
  "image": "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTjfPYTgqK_tUVKgReKL4U4lib8p57KSgeuFMGO2l4RxpyFdANFR2qyFPQ&s=10",
  "description": description,
  "url": Astro.url.href,
  "telephone": `+${siteConfig.whatsapp}`,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address,
    "addressLocality": "Bantul",
    "addressRegion": "DIY",
    "postalCode": "55184",
    "addressCountry": "ID"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": siteConfig.coordinates.lat,
    "longitude": siteConfig.coordinates.lng
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": "04:30",
    "closes": "22:00"
  },
  "sameAs": siteConfig.socials.map(social => social.url).filter(url => url !== '#')
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
