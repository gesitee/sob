---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/seo/SEO.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import WhatsAppFloatingButton from '../../components/layout/WhatsAppFloatingButton.astro';
---

<BaseLayout>
  <Fragment slot="seo">
    <SEO title="Lauk Pauk Segar Bantul — Sayur Online Bantul" description="Tersedia ikan, ayam, daging, tahu, tempe dan aneka lauk pauk segar lainnya. Belanja lauk pauk praktis di Bantul siap antar." />
    <JsonLd title="Lauk Pauk Segar Bantul" description="Belanja lauk pauk segar di Bantul." />
  </Fragment>

  <Navbar />
  
  <main class="pt-24 sm:pt-32 pb-16 bg-slate-50 min-h-[80vh] flex items-center">
    <div class="max-w-[1280px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
      
      <!-- Premium Category Showcase -->
      <div class="bg-white rounded-[2.5rem] p-6 sm:p-10 lg:p-16 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.05)] border border-gray-100 relative overflow-hidden">
        <!-- Subtle background decoration -->
        <div class="absolute top-0 right-0 w-2/3 h-full bg-gradient-to-l from-red-50/50 to-transparent pointer-events-none" aria-hidden="true"></div>
        
        <div class="flex flex-col lg:flex-row items-center gap-12 lg:gap-20 relative z-10">
          
          <!-- Text Content -->
          <div class="w-full lg:w-1/2 order-2 lg:order-1 text-center lg:text-left">
            <div class="inline-flex items-center justify-center w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-red-100 text-red-500 mb-6 sm:mb-8 shadow-sm">
              <i class="fas fa-fish text-3xl sm:text-4xl"></i>
            </div>
            
            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-black text-gray-900 mb-6 leading-tight">
              Lauk <span class="text-red-500">Pauk</span>
            </h1>
            
            <p class="text-base sm:text-lg text-gray-600 leading-relaxed mb-8 sm:mb-10 max-w-xl mx-auto lg:mx-0 font-medium">
              Sedia aneka lauk segar setiap hari. Mulai dari daging ayam, sapi, aneka ikan laut & tawar, hingga lauk nabati seperti tahu dan tempe.
            </p>
            
            <!-- CTA Box -->
            <div class="bg-gray-50 rounded-[1.5rem] p-6 sm:p-8 border border-gray-100 inline-block w-full max-w-md mx-auto lg:mx-0 shadow-sm relative group overflow-hidden">
              <div class="absolute inset-0 bg-red-500/5 transform translate-y-full group-hover:translate-y-0 transition duration-300"></div>
              <div class="relative z-10">
                <h3 class="text-lg sm:text-xl font-extrabold text-gray-900 mb-2">Pesan Sekarang</h3>
                <p class="text-xs sm:text-sm text-gray-500 mb-6 font-medium leading-relaxed">Kirim daftar pesanan lauk pauk Anda lewat WhatsApp. Bisa request dipotong/dibersihkan sesuai kebutuhan masak Anda.</p>
                
                <a href="https://wa.me/62895804069320?text=Halo%20SOB,%20saya%20mau%20pesan%20Lauk%20Pauk" target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-3 w-full rounded-xl bg-red-500 px-8 py-4 text-base sm:text-lg font-bold text-white shadow-[0_10px_20px_-10px_rgba(239,68,68,0.4)] transition-all hover:bg-red-600 hover:-translate-y-1 active:scale-[.98]">
                  <i class="fab fa-whatsapp text-2xl"></i> Pesan via WhatsApp
                </a>
              </div>
            </div>
          </div>
          
          <!-- Image Content -->
          <div class="w-full lg:w-1/2 order-1 lg:order-2">
            <div class="relative w-full max-w-md mx-auto aspect-square group">
              <!-- Decorative background glow -->
              <div class="absolute inset-0 bg-red-400/20 rounded-[2.5rem] blur-2xl transform group-hover:scale-105 transition duration-500"></div>
              
              <img 
                src="/assets/laukpauk.jpg" 
                alt="Lauk Pauk" 
                class="relative w-full h-full object-cover rounded-[2.5rem] shadow-2xl border-4 border-white transform group-hover:-translate-y-2 transition duration-500"
              />
              
              <!-- Floating Badge -->
              <div class="absolute -bottom-4 -left-4 sm:-bottom-6 sm:-left-8 bg-white p-3 sm:p-4 rounded-2xl shadow-xl flex items-center gap-3 sm:gap-4 animate-[bounce_3s_infinite]">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-full bg-red-100 text-red-500 flex items-center justify-center text-lg sm:text-xl">
                  <i class="fas fa-drumstick-bite"></i>
                </div>
                <div>
                  <p class="font-bold text-gray-900 text-xs sm:text-sm">Potong Sesuai</p>
                  <p class="text-[10px] sm:text-xs font-medium text-gray-500">Bebas Request</p>
                </div>
              </div>
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
  </main>

  <Footer />
  <WhatsAppFloatingButton />
</BaseLayout>
